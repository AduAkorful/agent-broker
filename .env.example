# Agent-to-Agent Data Broker — Environment Configuration
# Copy to .env and fill in values. All values shown are defaults.

# Required at startup (server exits if missing)
ADMIN_API_KEY="change-me-to-a-long-random-string"
BINANCE_MCP_AUTH_TOKEN="your-binance-mcp-auth-token"

# Optional — defaults shown
DATABASE_PATH=":memory:"   # Use /data/agent-broker.sqlite in production
PORT=3000
NODE_ENV="production"
TRUST_PROXY="false"        # Set "true" behind a load balancer
CORS_ORIGINS=""            # Comma-separated origin allowlist; empty = disabled

# B402 payment config
PAYMENTS_ENABLED="true"              # false = skip 402/facilitator; agent/info shows payments_enabled + zero prices
B402_PAY_TO="0xYourSellerWalletHere" # seller payee (required in production when payments enabled)

B402_FACILITATOR_URL="https://facilitatorv3.b402.ai"
B402_RELAYER="0xE91b564EB8DFF305Ff8efA332f84c487b9da5171"
B402_PRICE_ATOMIC="50000000000000000"   # 0.05 USDT (18 decimals)
B402_PRICE_DECIMAL="0.05"
B402_VALIDITY_WINDOW="3600"              # seconds

# Rate limiting (per IP)
B402_RATE_LIMIT_MAX="10"                 # max requests per window
B402_RATE_LIMIT_WINDOW="60"               # window in seconds

# Treasury controls
B402_TREASURY_ACTIVE="true"
B402_TREASURY_DAILY_LIMIT="10000000000000000000"     # 10 USDT/day
B402_TREASURY_SINGLE_LIMIT="1000000000000000000"     # 1 USDT/withdrawal
B402_WITHDRAWAL_WHITELIST="0x0000000000000000000000000000000000000001"
B402_TOKEN_WHITELIST="0x55d398326f99059fF775485246999027B3197955,0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d"

# Secondary venue contrast (public CCXT; Binance MCP remains primary)
SECONDARY_VENUE="bybit"                 # ccxt exchange id: okx, bybit, ...
SECONDARY_VENUE_TIMEOUT_MS="5000"
SECONDARY_VENUE_ENABLED="true"        # set "false" to disable contrast fetches

# Market data / MCP
MARKET_CACHE_MAX_STALE_SECONDS="900"
MCP_CONCURRENCY="5"
